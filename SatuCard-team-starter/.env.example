SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace-me

# Optional Terra pilot. Server-only. Remains disabled until explicit activation.
# Apply database/ai-copy-quota.sql manually before enabling. No key in browser/Git.
OPENAI_API_KEY=
OPENAI_COPY_ENABLED=false
OPENAI_COPY_MODEL=gpt-6.1-terra
# Comma-separated verified Supabase user UUIDs allowed to spend the shared budget.
# Empty or * does not grant access. This is a pilot allowlist, not paid billing.
OPENAI_COPY_ALLOWED_USER_IDS=

# Optional free-tier Gemini chat. Explicit selection, no OpenAI fallback.
SATUCARD_AI_PROVIDER=openai
GEMINI_API_KEY=
GEMINI_CHAT_ENABLED=false
GEMINI_CHAT_MODEL=gemini-3.1-flash-lite
GEMINI_ALLOWED_USER_IDS=
# Optional: one allowlisted account skips SatuCard's Gemini chat quota.
GEMINI_ADMIN_USER_ID=

# Optional opt-in Groq text fallback after a Gemini 429.
GROQ_CHAT_FALLBACK_ENABLED=false
GROQ_API_KEY=

# Optional text fallbacks in Vercel Preview only, e.g. mistral,cloudflare,cohere.
SAI_PREVIEW_FALLBACKS=
MISTRAL_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
COHERE_API_KEY=

# Synthetic evaluation in Vercel Preview only, e.g. alibaba,scaleway.
# Verify remaining trial credit and provider billing controls before enabling.
SAI_PREVIEW_EVALUATION=
ALIBABA_API_KEY=
SCALEWAY_API_KEY=

# Optional paid text model, offered as an explicit choice only in Vercel Preview.
SAI_PREVIEW_ANYMODEL_ENABLED=false
ANYMODEL_API_KEY=
